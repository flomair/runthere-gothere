# Create an API application at https://www.strava.com/settings/api
# "Authorization Callback Domain" must be your deployment domain (e.g. my-app.vercel.app) or "localhost" for dev.
# Only the Client ID and Client Secret are needed. Ignore "Your Access Token" / "Your Refresh Token" on that page:
# they only have the "read" scope (no activities). The app obtains its own tokens when you click "Connect with Strava"
# and refreshes them automatically.
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=

# NOT from Strava: make up any long random string (e.g. `openssl rand -hex 32`).
# The app uses it to encrypt the cookie that holds your Strava tokens.
SESSION_SECRET=

# Optional: Mapillary client token for recent street-level photos (https://www.mapillary.com/dashboard/developers)
MAPILLARY_TOKEN=

# Optional: contact used in the User-Agent for OpenStreetMap Nominatim (their usage policy asks for one)
CONTACT_EMAIL=

# Optional: Google Places API (New) key for nearby places with ratings & reviews
GOOGLE_PLACES_API_KEY=

# Optional: Anthropic API key for the AI travel narrator.
# Users can instead paste their own key in the app (kept in their browser, sent per request).
ANTHROPIC_API_KEY=
# Only if that key is organization-level (not scoped to a workspace): the workspace to bill.
ANTHROPIC_WORKSPACE_ID=
