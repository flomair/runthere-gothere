# Create an API application at https://www.strava.com/settings/api
# "Authorization Callback Domain" must be your deployment domain (e.g. my-app.vercel.app) or "localhost" for dev.
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=

# Any long random string – used to encrypt the Strava session cookie.
# e.g.  openssl rand -hex 32
SESSION_SECRET=

# Optional: Mapillary client token for recent street-level photos (https://www.mapillary.com/dashboard/developers)
MAPILLARY_TOKEN=

# Optional: contact used in the User-Agent for OpenStreetMap Nominatim (their usage policy asks for one)
CONTACT_EMAIL=

# Optional: Google Places API (New) key for nearby places with ratings & reviews
GOOGLE_PLACES_API_KEY=

# Optional: Anthropic API key for the AI travel narrator.
# Users can instead paste their own key in the app (kept in their browser, sent per request).
ANTHROPIC_API_KEY=
