# ---------- Google sign-in & database (Firebase) ----------
# Firebase console → Project settings → General → Your apps → Web app config.
# These four are public identifiers (they end up in the browser bundle), not secrets.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Server access to Firestore: Project settings → Service accounts → Generate new private key.
# Paste the whole JSON (or base64 of it). Keep it secret.
FIREBASE_SERVICE_ACCOUNT=

# Google accounts with admin rights (comma separated). Admins manage who else may sign in.
ADMIN_EMAILS=

# ---------- Strava ----------
# Create an API application at https://www.strava.com/settings/api
# "Authorization Callback Domain" must be your deployment domain (e.g. my-app.vercel.app) or "localhost" for dev.
# Only the Client ID and Client Secret are needed. Ignore "Your Access Token" / "Your Refresh Token" on that page.
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=

# ---------- Secrets ----------
# NOT from Strava: make up any long random string (e.g. `openssl rand -hex 32`).
# Encrypts the Strava tokens and each user's Anthropic key stored in Firestore.
# Don't change it later: stored secrets would become unreadable (users reconnect Strava / re-enter keys).
SESSION_SECRET=

# Protects the daily sync job. Any random string; Vercel sends it automatically to /api/cron/sync.
CRON_SECRET=

# ---------- Optional extras (shared by all users of the deployment) ----------
# Mapillary client token for recent street-level photos (https://www.mapillary.com/dashboard/developers)
MAPILLARY_TOKEN=
# Google Places API (New) key for nearby places with ratings & reviews
GOOGLE_PLACES_API_KEY=
# Contact used in the User-Agent for OpenStreetMap Nominatim (their usage policy asks for one)
CONTACT_EMAIL=

# Note: there is no shared Anthropic key. Every user adds their own key in the narrator settings;
# it is stored encrypted in their account.
