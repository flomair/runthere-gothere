{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/narrate.ts": {
      "maxDuration": 60
    },
    "api/route.ts": {
      "maxDuration": 60
    },
    "api/trails/route.ts": {
      "maxDuration": 60
    },
    "api/strava/callback.ts": {
      "maxDuration": 60
    },
    "api/strava/sync.ts": {
      "maxDuration": 60
    },
    "api/cron/sync.ts": {
      "maxDuration": 300
    }
  },
  "crons": [
    {
      "path": "/api/cron/sync",
      "schedule": "30 4 * * *"
    }
  ]
}
